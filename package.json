{
    "name": "galaxy-charts",
    "description": "Galaxy Charts",
    "keywords": [
        "galaxy",
        "charts"
    ],
    "license": "MIT",
    "version": "0.1.19",
    "type": "module",
    "main": "./dist/galaxy-charts.umd.cjs",
    "module": "./dist/galaxy-charts.js",
    "types": "./dist/galaxy-charts.d.ts",
    "exports": {
        ".": {
            "types": "./dist/galaxy-charts.d.ts",
            "import": "./dist/galaxy-charts.js",
            "require": "./dist/galaxy-charts.umd.cjs"
        },
        "./galaxy-charts.inputs.json": "./dist/galaxy-charts.inputs.json",
        "./runtime": {
            "types": "./dist/galaxy-charts-runtime-types/lib/galaxy-charts-runtime.d.ts",
            "import": "./dist/galaxy-charts.runtime.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --config vite.config.runtime.js",
        "preview": "vite preview",
        "lint": "eslint 'src/**/*.{js,ts,vue}' 'lib/**/*.ts'",
        "lint:fix": "eslint 'src/**/*.{js,ts,vue}' 'lib/**/*.ts' --fix",
        "prettier": "prettier --config ./prettier.config.js --write '*.json' '**/*.{css,js,ts,vue,astro,md,mdx}'",
        "test": "vitest --coverage.enabled --no-cache"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@heroicons/vue": "^2.2.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/dompurify": "^3.2.0",
        "@types/markdown-it": "^14.2.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/browser": "^5.0.5",
        "@vitest/coverage-istanbul": "^5.0.5",
        "@vitest/eslint-plugin": "^1.6.27",
        "@vitest/ui": "^5.0.5",
        "@vue/test-utils": "^2.5.1",
        "ajv": "^8.20.0",
        "dompurify": "^3.4.17",
        "eslint": "^10.13.0",
        "eslint-plugin-vue": "^10.11.1",
        "galaxy-charts-xml-parser": "^1.0.3",
        "globals": "^17.13.0",
        "happy-dom": "^21.0.3",
        "markdown-it": "^15.0.3",
        "naive-ui": "^2.45.3",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vite-plugin-checker": "^0.14.5",
        "vite-plugin-css-injected-by-js": "^5.0.2",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^5.0.5",
        "vue": "^3.5.44",
        "vue-tsc": "^3.3.13",
        "zod": "^4.6.7"
    }
}
